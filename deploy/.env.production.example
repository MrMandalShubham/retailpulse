# ------------------------------------------------------------------
# DIP Engine — PRODUCTION environment
# Copy to /opt/dip-engine/.env on the droplet and fill in real values.
# Never commit the filled-in file.
# ------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info

# API server — bound to localhost; expose via a reverse proxy / firewall.
API_PORT=3000
API_HOST=127.0.0.1

# DigitalOcean Managed Postgres.
#   - From a droplet in the same VPC, use the PRIVATE host and sslmode=require.
#   - Get the connection string from: DO console → Databases → your cluster →
#     Connection details → "Connection string".
#   - Create a dedicated app user (not doadmin) and, once discovery is seeded,
#     a read-only user for any dashboard/BI consumer.
DATABASE_URL=postgres://APP_USER:PASSWORD@PRIVATE_HOST:25060/defaultdb?sslmode=require

# Fetch timeout for discovery + ingestion HTTP calls (optional, default 15000).
# INGEST_FETCH_TIMEOUT_MS=15000
