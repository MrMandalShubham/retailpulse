# ------------------------------------------------------------------
# DIP Engine — environment configuration
# Copy to .env and adjust for your environment. Never commit .env.
#
# The engine is a storage-free 2-step pipeline (discover → ingest+clean),
# so the only required variable is DATABASE_URL.
# ------------------------------------------------------------------

# Application
NODE_ENV=development
LOG_LEVEL=info

# API server
API_PORT=3000
API_HOST=0.0.0.0

# PostgreSQL
#   Local dev (docker-compose):  postgres://dip:dip@localhost:5432/dip_engine
#   DigitalOcean Managed PG:      postgres://USER:PASS@HOST:25060/defaultdb?sslmode=require
DATABASE_URL=postgres://dip:dip@localhost:5432/dip_engine

# Fetch timeout for discovery + ingestion HTTP calls (optional, default 15000).
# INGEST_FETCH_TIMEOUT_MS=15000
