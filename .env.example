# ------------------------------------------------------------------
# DIP Engine — environment configuration
# Copy to .env and adjust for your environment. Never commit .env.
# ------------------------------------------------------------------

# Application
NODE_ENV=development
LOG_LEVEL=info

# API server
API_PORT=3000
API_HOST=0.0.0.0

# PostgreSQL (matches docker-compose.yml defaults for local dev)
DATABASE_URL=postgres://dip:dip@localhost:5432/dip_engine

# ------------------------------------------------------------------
# Object storage for raw payloads (Phase 2)
# Local dev: MinIO from docker-compose (values below match it).
# Production: point at DigitalOcean Spaces, e.g.
#   DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
#   DO_SPACES_REGION=sgp1
#   DO_SPACES_FORCE_PATH_STYLE=false
# ------------------------------------------------------------------
DO_SPACES_ENDPOINT=http://localhost:9000
DO_SPACES_REGION=us-east-1
DO_SPACES_BUCKET=dip-engine-raw
DO_SPACES_KEY=dip-minio
DO_SPACES_SECRET=dip-minio-secret
DO_SPACES_FORCE_PATH_STYLE=true

# Raw ingestion worker (optional, defaults shown)
# INGEST_FETCH_TIMEOUT_MS=15000

# ------------------------------------------------------------------
# AI review layer (Phase 4)
# SAFE DEFAULT: provider 'mock' makes no external call and costs nothing.
# To use Mistral (client's chosen provider), set:
#   AI_PROVIDER=mistral
#   AI_MODEL=mistral-small-latest
#   MISTRAL_API_KEY=<your key — never commit it>
# ------------------------------------------------------------------
AI_PROVIDER=mock
# AI_MODEL=mistral-small-latest
# MISTRAL_API_KEY=
# AI_REVIEW_MAX_ITEMS=20
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2

# ------------------------------------------------------------------
# Later-phase placeholders — leave unset
# ------------------------------------------------------------------
# REDIS_URL=
