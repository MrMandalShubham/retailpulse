{
  "name": "dip-engine",
  "version": "0.1.0",
  "private": true,
  "description": "DIP Engine — production-grade data ingestion and normalization platform for global product intelligence",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @dip/api dev",
    "dev:worker": "pnpm --filter @dip/worker dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "pnpm --filter @dip/db generate",
    "db:migrate": "pnpm --filter @dip/db migrate",
    "db:seed": "pnpm --filter @dip/db seed",
    "db:studio": "pnpm --filter @dip/db studio",
    "bucket:ensure": "pnpm --filter @dip/storage ensure-bucket",
    "ingest:run": "pnpm --filter @dip/worker ingest",
    "transform:run": "pnpm --filter @dip/worker transform",
    "ai-review:run": "pnpm --filter @dip/worker ai-review",
    "promote:run": "pnpm --filter @dip/worker promote",
    "facts:run": "pnpm --filter @dip/worker facts",
    "enrich:run": "pnpm --filter @dip/worker enrich",
    "render:run": "pnpm --filter @dip/worker render"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "prettier": "^3.6.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
